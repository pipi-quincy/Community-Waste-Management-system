<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Community_waste_management_Backup"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-02 11:10:11 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLVU2REoyNk87MjAyNi0xMS0wMTswOToxMDowNCBQTTsyNzMz"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLVU2REoyNk87MjAyNi0xMS0wMjsxMToxMDoxMSBBTTs1OzI4MjI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Welcome to the Community Waste Management System&quot;" newline="True"/>
            <declare name="CommunityName" type="String" array="False" size=""/>
            <declare name="wasteCategory" type="String" array="False" size=""/>
            <declare name="recommendation" type="String" array="False" size=""/>
            <declare name="continuechoice" type="String" array="False" size=""/>
            <assign variable="continuechoice" expression="&quot;Yes&quot;"/>
            <while expression="continueChoice==&quot;Yes&quot;">
                <output expression="&quot;Enter your community Name&quot;" newline="True"/>
                <input variable="CommunityName"/>
                <assign variable="wasteCategory" expression="&quot;&quot;"/>
                <while expression="wasteCategory != &quot;Low&quot; and wasteCategory != &quot;Medium&quot; and wasteCategory != &quot;High&quot;">
                    <output expression="&quot;Enter waste category (Low, Medium, High):&quot;" newline="True"/>
                    <input variable="wasteCategory"/>
                </while>
                <if expression="wasteCategory == &quot;Low&quot;">
                    <then>
                        <assign variable="recommendation" expression="&quot;Normal Waste Collection&quot;"/>
                    </then>
                    <else>
                        <if expression="wasteCategory == &quot;Medium&quot;">
                            <then>
                                <assign variable="recommendation" expression="&quot;Scheduled Waste Collection&quot;"/>
                            </then>
                            <else>
                                <if expression="wasteCategory == &quot;High&quot;">
                                    <then>
                                        <assign variable="recommendation" expression="&quot;Urgent Waste Collection&quot;"/>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <output expression="&quot;Community Name: &quot;&amp; communityName" newline="True"/>
                <output expression="&quot;Waste Category: &quot;&amp; wasteCategory" newline="True"/>
                <output expression="&quot;Collection Recommendation: &quot;&amp; recommendation" newline="True"/>
                <output expression="&quot;Do you want to record another waste report? (Yes/No)&quot;" newline="True"/>
                <input variable="continueChoice"/>
            </while>
            <output expression="&quot;Thank you for using the Community Waste Management System.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
